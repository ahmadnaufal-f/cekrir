{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": false,
  "trailingComma": "all",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "uv.lock",
    "apps/backend/",
    "apps/frontend/android/",
    "apps/frontend/ios/",
    "dist/",
    "node_modules/",
    "prisma/schema.prisma",
    "pnpm-lock.yaml"
  ]
}
