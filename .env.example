# Development credentials for compose.yaml; use separate credentials in production.
# Alembic reads this PostgreSQL URL for database migrations and runtime access.
DATABASE_URL=postgresql://cekrir:cekrir@127.0.0.1:5432/cekrir
# Tests clear this dedicated database. Its name must end in _test.
TEST_DATABASE_URL=postgresql://cekrir:cekrir@127.0.0.1:5432/cekrir_test

# Backend JWT, Redis, courier, and camera settings are in apps/backend/.env.
