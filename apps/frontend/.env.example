# Live authentication, shipments, notifications, and user roles. No fixture fallback.
VITE_APP_MODE=live
# For development only: VITE_APP_MODE=mock (ignored in production builds).
# Public URL only. Never put server keys, camera passwords or tokens here.
VITE_API_BASE_URL=/api/v1
# Vite proxies HTTP and WebSocket traffic to FastAPI during development.
# For a hosted frontend, use a reachable HTTPS API and allow the frontend origin in backend CORS.
# The static hosting configuration does not proxy /api to a backend.
# For native builds use an absolute HTTPS URL reachable by the device:
# VITE_API_BASE_URL=https://api.your-domain.example/api/v1
