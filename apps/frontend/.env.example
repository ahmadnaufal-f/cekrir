# Household services are not integrated yet. Live never falls back to fixtures.
VITE_APP_MODE=live
# For development only: VITE_APP_MODE=mock (ignored in production builds).
# Public URL only. Never put server keys, camera passwords or tokens here.
VITE_API_BASE_URL=/api/v1
# Vite proxies this path to FastAPI during browser development.
# For native builds use an absolute HTTPS URL reachable by the device:
# VITE_API_BASE_URL=https://api.your-domain.example/api/v1
