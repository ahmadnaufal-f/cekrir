# Backend settings are loaded from this file regardless of the working directory.
# DATABASE_URL here overrides the repository-root .env for the backend and Alembic.
# DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@localhost:5432/cekrir
CEKRIR_CORS_ORIGINS=["https://cekrir.arkaes.dev","http://localhost:5173","http://127.0.0.1:5173","capacitor://localhost","http://localhost","https://localhost"]
CEKRIR_REDIS_URL=redis://127.0.0.1:6379/0
# Set a stable secret of at least 32 characters; otherwise local tokens reset on restart.
# CEKRIR_JWT_SECRET_KEY=generate-a-unique-random-secret-of-at-least-32-characters
# Optional first-admin account. Configure both values to enable admin-only operations.
# CEKRIR_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# CEKRIR_BOOTSTRAP_ADMIN_FULL_NAME=Administrator
# CEKRIR_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-12-character-or-longer-password
# The Alembic seed migration creates a development admin, member, and location.
# Passwords are required if those accounts do not already exist; alternatively
# put them in the ignored apps/backend/.env.seed file or the process environment.
# CEKRIR_SEED_ADMIN_EMAIL=admin@example.test
# CEKRIR_SEED_MEMBER_EMAIL=member@example.test
# CEKRIR_SEED_LOCATION=Main Location
# CEKRIR_SEED_ADMIN_PASSWORD=replace-with-a-unique-password
# CEKRIR_SEED_MEMBER_PASSWORD=replace-with-another-unique-password

# Resend email. Add your new API key to the real .env; never commit it.
# The sender is the From address. Recipients come from user emails in the database.
# onboarding@resend.dev is for testing and has Resend recipient restrictions.
# For sending to users, verify your domain in Resend and replace the sender address.
CEKRIR_EMAIL_PROVIDER=resend
CEKRIR_RESEND_API_KEY=
CEKRIR_RESEND_FROM=onboarding@resend.dev
# Email verification needs a public confirmation-page URL.
CEKRIR_VERIFICATION_URL=https://api.cekrir.bakuretsumagic.my.id/api/v1/auth/verify-email
# Resend package notifications require cameras and members assigned to locations.
# Keep the API key in your local .env and never commit it.
# SMTP remains available when CEKRIR_EMAIL_PROVIDER=smtp.
# CEKRIR_SMTP_HOST=smtp.example.com
# CEKRIR_SMTP_PORT=587
# CEKRIR_SMTP_SECURITY=starttls
# CEKRIR_SMTP_USERNAME=
# CEKRIR_SMTP_PASSWORD=
# CEKRIR_SMTP_FROM=Cekrir <no-reply@example.com>

# demo is an offline fixture. http calls your normalized tracking gateway.
CEKRIR_TRACKING_PROVIDER=demo
# CEKRIR_TRACKING_API_URL=https://your-gateway.example/track
# CEKRIR_TRACKING_API_KEY=

# BinderByte tracking: paste your API key here when you create an account.
# Required for POST /api/v1/tracking/binderbyte; leave empty until configured.
# This endpoint does not require changing CEKRIR_TRACKING_PROVIDER above.
CEKRIR_BINDERBYTE_API_KEY=
# TODO: Set a courier code to enable automatic tracking on matching detections.
CEKRIR_BINDERBYTE_DETECTION_COURIER=

# CCTV URL and credentials are encrypted using a Fernet key. Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep the same key and back it up securely; changing it makes existing CCTV data unreadable.
# CEKRIR_CCTV_ENCRYPTION_KEY=
# Firebase push is disabled until the service-account JSON is available on the server.
# CEKRIR_FIREBASE_CREDENTIALS_FILE=/run/secrets/firebase-service-account.json

# Shared key for desktop/ESP32 camera ingestion; the worker/device requires this key.
# This is not user authentication. Keep it out of the frontend and replace before use.
# CEKRIR_INGEST_API_KEY=replace-with-a-random-device-key

# Optional CCTV worker configuration. Keep RTSP passwords in this file.
# CEKRIR_CAMERA_SOURCE=rtsp://user:password@192.168.1.10:554/stream
CEKRIR_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Local-only BARDI CCTV snapshot POC (POST http://127.0.0.1:8002/snapshot).
# Use the stream URI discovered through ONVIF. Keep credentials separate and untracked.
# CEKRIR_CCTV_RTSP_URL=rtsp://192.168.18.23:8554/Streaming/Channels/101
# CEKRIR_CCTV_USERNAME=admin
# CEKRIR_CCTV_PASSWORD=

# Tuya Smart Control cloud capture. Select the camera ID returned by the Tuya device list.
# This captures one JPEG after the first accepted scan for a shipment and stores it locally.
# TUYA_API_KEY=sk-...
# TUYA_API_ENDPOINT=https://openapi-sg.iotbing.com
# TUYA_CCTV_DEVICE_ID=
# CEKRIR_CCTV_PHOTO_DIR=/persistent/data/cctv-photos
