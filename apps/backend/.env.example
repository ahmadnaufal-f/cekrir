# Loaded relative to apps/backend by the root dev command.
# DATABASE_URL is shared with Prisma in the repository-root .env.
CEKRIR_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","capacitor://localhost","http://localhost","https://localhost"]

# demo is an offline fixture. http calls your normalized tracking gateway.
CEKRIR_TRACKING_PROVIDER=demo
# CEKRIR_TRACKING_API_URL=https://your-gateway.example/track
# CEKRIR_TRACKING_API_KEY=

# Optional shared key for the camera ingestion endpoint only.
# This is NOT user authentication. Keep this value out of the frontend.
# CEKRIR_INGEST_API_KEY=

# Optional CCTV worker configuration. Keep RTSP passwords in this file.
# CEKRIR_CAMERA_SOURCE=rtsp://user:password@192.168.1.10:554/stream
CEKRIR_API_BASE_URL=http://127.0.0.1:8000/api/v1
