# Copy to apps/backend/.env on the VM, then edit. Keep it private and never commit it.
# If reusing an existing Docker volume from another project name, set that name here.
# COMPOSE_PROJECT_NAME=cekrir
# Use only letters and numbers in POSTGRES_PASSWORD so it is safe in DATABASE_URL.
POSTGRES_PASSWORD=replace_with_your_postgres_password
CEKRIR_JWT_SECRET_KEY=replace_with_hex_from_openssl
CEKRIR_INGEST_API_KEY=replace_with_hex_from_openssl

# Migration 0007 creates these verified seed accounts once on a new database.
# Use real addresses and strong, different passwords. Never use the example values.
CEKRIR_SEED_ADMIN_EMAIL=admin@example.com
CEKRIR_SEED_ADMIN_PASSWORD=replace_with_unique_admin_password
CEKRIR_SEED_MEMBER_EMAIL=member@example.com
CEKRIR_SEED_MEMBER_PASSWORD=replace_with_unique_member_password
CEKRIR_SEED_LOCATION="Main Location"

# Resend email. Add your new API key to the real .env; never commit it.
# The sender is the From address. Recipients come from user emails in the database.
# onboarding@resend.dev is for testing and has Resend recipient restrictions.
# For sending to users, verify your domain in Resend and replace the sender address.
CEKRIR_EMAIL_PROVIDER=resend
CEKRIR_RESEND_API_KEY=
CEKRIR_RESEND_FROM=onboarding@resend.dev
CEKRIR_VERIFICATION_URL=https://api.cekrir.bakuretsumagic.my.id/api/v1/auth/verify-email

# Exact origins for the hosted frontend and standard Capacitor apps.
CEKRIR_CORS_ORIGINS='["https://cekrir.arkaes.dev","http://localhost:5173","http://127.0.0.1:5173","capacitor://localhost","http://localhost","https://localhost"]'
# CEKRIR_TRACKING_PROVIDER=demo

# Configure these later. Never commit the actual keys or Firebase JSON file.
# CEKRIR_BINDERBYTE_API_KEY=
# TODO: Set a courier code to enable automatic tracking for matching detections.
# CEKRIR_BINDERBYTE_DETECTION_COURIER=
# CEKRIR_CCTV_ENCRYPTION_KEY=
# CEKRIR_FIREBASE_CREDENTIALS_FILE=/run/secrets/firebase-service-account.json
